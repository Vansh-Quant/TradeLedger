{
  "name": "tradeledger",
  "private": true,
  "version": "0.1.0",
  "description": "Personal quantitative trading, research, execution, analytics, and trading operating system.",
  "packageManager": "npm@11",
  "workspaces": [
    "core/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p packages/workstation-glass/tsconfig.json --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "check": "npm run typecheck && npm test && npm run test:glass",
    "test:glass": "npm run test --workspace packages/workstation-glass",
    "test:competition-load": "vitest run tests/load/competition-load.test.ts",
    "test:competition-concurrency": "vitest run tests/load/competition-concurrency.test.ts",
    "test:competition": "vitest run tests/core/phase-6-competition.test.ts tests/application/competition-application.test.ts tests/application/competition-realtime-persistence.test.ts tests/application/competition-order-gateway.test.ts tests/api/competition-api.test.ts tests/load/competition-load.test.ts tests/load/competition-concurrency.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
